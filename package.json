{
  "name": "picti",
  "private": true,
  "version": "0.1.0",
  "description": "PICTI — le géocadrage : redécouvrir chaque photo à l'endroit précis et sous l'angle exact où elle a été prise.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --host --mode https",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "exifr": "^7.1.3",
    "maplibre-gl": "^6.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "supercluster": "^9.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.85.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
